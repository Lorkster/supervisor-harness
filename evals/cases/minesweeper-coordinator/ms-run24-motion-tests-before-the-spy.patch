-test.describe('motion', () => {
-  // Same 7x7 layout as the [R27] test: (5,0) is a zero cell whose cascade
-  // reveals nine cells while the game stays playing, so the ripple is
-  // exercised mid-game (not by an instant win).
-  const CASCADE_BOARD = '.*.....,*.*....,.......,...*...,..*....,.......,..*....';
-
-  // These motion tests need animations to actually run: the app only animates
-  // when the user does not prefer reduced motion. Headless Chromium can report
-  // a reduced-motion default, so request no-preference explicitly (R34 below
-  // overrides this with reduce for its own test).
-  test.use({ reducedMotion: 'no-preference' });
-
-  test('[R30] the reveal ripple staggers newly revealed cells with a fixed step', async ({ page }) => {
-    await installSpies(page);
-    await page.goto(`/?board=${encodeURIComponent(CASCADE_BOARD)}`);
-    // (5,0) is a zero cell in this layout: one click reveals many cells.
-    await page.click('#board button[data-row="5"][data-col="0"]');
-    await expect(page.locator('#status'), 'the cascade must leave the game playing').toHaveAttribute('data-status', 'playing');
-    const recorded = await anims(page);
-
-    expect(recorded.length, 'a cascade must animate more than one newly revealed cell').toBeGreaterThanOrEqual(2);
-
-    const delays = [...new Set(recorded.map((a) => a.delay))].sort((x, y) => x - y);
-    expect(delays[0], 'the clicked cell starts its animation at the input (delay 0 ms)').toBe(0);
-    expect(delays.length, 'cells must start at staggered times, not all at once').toBeGreaterThanOrEqual(2);
-
-    // All non-zero delays must be multiples of a fixed step in [15, 40] ms.
-    const nonZero = delays.filter((d) => d > 0);
-    let step = nonZero[0];
-    for (let i = 1; i < nonZero.length; i += 1) step = gcd(step, nonZero[i]);
-    expect(step, 'the stagger step must be a fixed value in the 15–40 ms range').toBeGreaterThanOrEqual(15);
-    expect(step, 'the stagger step must be a fixed value in the 15–40 ms range').toBeLessThanOrEqual(40);
-    for (const d of nonZero) {
-      expect(d % step, `delay ${d} ms must be a multiple of the fixed step ${step} ms`).toBe(0);
-    }
-
-    expect(delays[delays.length - 1], 'no cell may start later than 1000 ms after the input').toBeLessThanOrEqual(1000);
-
-    for (const a of recorded) {
-      expect(a.duration, 'each reveal animation must last 100–600 ms').toBeGreaterThanOrEqual(100);
-      expect(a.duration, 'each reveal animation must last 100–600 ms').toBeLessThanOrEqual(600);
-    }
-  });
-
