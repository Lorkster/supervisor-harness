-interface AnimRecord { row: string; col: string; delay: number; duration: number }
-interface AudioOsc { type: string; freq: number }
-interface AudioRecord { contextsCreated: number; oscillators: AudioOsc[] }
-
-/**
- * Install Web Animations + Web Audio spies before the page scripts run.
- */
-export async function installSpies(page: Page): Promise<void> {
-  await page.addInitScript(() => {
-    const anims: Array<{ row: string; col: string; delay: number; duration: number }> = [];
-    (window as unknown as { __anims: typeof anims }).__anims = anims;
-
-    const origAnimate = Element.prototype.animate;
-    Element.prototype.animate = function animate(this: Element, keyframes: Keyframe[] | PropertyIndexMap, options?: number | KeyframeAnimationOptions) {
-      let delay = 0;
-      let duration = 0;
-      if (typeof options === 'number') {
-        duration = options;
-      } else if (options) {
-        delay = Number(options.delay ?? 0);
-        duration = Number(options.duration ?? 0);
-      }
-      const el = this as HTMLElement;
-      anims.push({ row: el.dataset?.row ?? '', col: el.dataset?.col ?? '', delay, duration });
-      return origAnimate.call(this, keyframes, options);
-    };
-
-    // Store the oscillator nodes themselves: the app sets each oscillator's
-    // frequency with setValueAtTime() *after* createOscillator returns, so the
-    // value must be read later (AudioParam.value reflects the last set value).
-    const record = { contextsCreated: 0, oscillators: [] as OscillatorNode[] };
-    (window as unknown as { __audio: typeof record }).__audio = record;
-
-    const OrigAudioContext = window.AudioContext;
-    if (!OrigAudioContext) return;
-    window.AudioContext = class extends OrigAudioContext {
-      constructor(...args: ConstructorParameters<typeof OrigAudioContext>) {
-        super(...args);
-        record.contextsCreated += 1;
-      }
-    };
-    const origCreateOsc = OrigAudioContext.prototype.createOscillator;
-    OrigAudioContext.prototype.createOscillator = function createOscillator(this: AudioContext) {
-      const osc = origCreateOsc.call(this);
-      record.oscillators.push(osc);
-      return osc;
-    };
-  });
-}
-
-async function audio(page: Page): Promise<AudioRecord> {
-  return page.evaluate(() => {
-    const raw = (window as unknown as { __audio: { contextsCreated: number; oscillators: OscillatorNode[] } }).__audio;
-    return {
-      contextsCreated: raw.contextsCreated,
-      oscillators: raw.oscillators.map((o) => ({ type: o.type, freq: o.frequency.value })),
-    };
-  });
-}
-
-async function anims(page: Page): Promise<AnimRecord[]> {
-  return page.evaluate(() => (window as unknown as { __anims: AnimRecord[] }).__anims);
-}
-
-/** Make sure the game is unmuted (the mute preference persists in localStorage). */
-async function ensureUnmuted(page: Page): Promise<void> {
-  const pressed = await page.locator('#mute').getAttribute('aria-pressed');
-  if (pressed === 'true') await page.click('#mute');
-}
-
-function gcd(a: number, b: number): number {
-  while (b !== 0) { const t = b; b = a % b; a = t; }
-  return a;
-}
