index 837a0c7..81e096d 100644
--- a/src/data/http.ts
+++ b/src/data/http.ts
@@ -33,6 +33,21 @@ export async function fetchJson(url: string): Promise<unknown> {
   try {
     response = await fetch(url);
   } catch (cause) {
+    // The browser reports no connection: classify it distinctly so a UI can
+    // say "needs connection" for an uncached file instead of a generic
+    // failure. A non-2xx response still means the network answered, so it
+    // stays 'fetch-failed'. `onLine` is read structurally -- this project's
+    // lib surface does not type it (the WebWorker/DOM split in
+    // tsconfig.sw.json) -- and navigator is absent outside a browser.
+    const offline =
+      typeof navigator !== 'undefined' &&
+      (navigator as unknown as { onLine?: boolean }).onLine === false;
+    if (offline) {
+      throw new DataError('offline-unavailable', `Could not reach ${url} while offline.`, {
+        url,
+        cause,
+      });
+    }
     throw new DataError('fetch-failed', `Could not reach ${url}.`, { url, cause });
   }
 
