diff --git a/e2e/offline.spec.ts b/e2e/offline.spec.ts
new file mode 100644
index 0000000..8a50cfc
--- /dev/null
+++ b/e2e/offline.spec.ts
@@ -0,0 +1,209 @@
+import { test, expect, type Page } from '@playwright/test';
+
+/**
+ * P3-18: the offline state, driven with a real network cut.
+ *
+ * e2e/serviceWorker.spec.ts proved the worker caches and serves; this proves
+ * what a gardener sees when the network is gone -- the part that only counts
+ * if the failure is real, so the cut comes from `context.setOffline(true)`,
+ * not from reading `navigator.onLine`. The phases:
+ *
+ * 1. Load online against the production build (port 4173 -- the worker does
+ *    not exist in dev), pick a town and save the garden, so the shell, the
+ *    catalogue index, the region pack and every shard the results use are in
+ *    the caches.
+ * 2. Delete one shard from the data cache -- done while online, because once
+ *    the cut is in any fetch of that file would be answered by the worker and
+ *    re-stored (storeVerified checks it against the manifest), so an offline
+ *    deletion would not stick. The index still lists its plants, but their
+ *    full records are now uncached -- the exact state P3-18's 'some shards
+ *    cached, some not' exists for (a saved garden spans several shards; P3-17
+ *    may have cached only the ones a previous load fetched).
+ * 3. `context.setOffline(true)` and reload. The cut is real: with the context
+ *    offline, a fetch of a file that is not in any cache throws (verified by
+ *    this test), so the network layer is genuinely down -- not merely
+ *    `navigator.onLine` flipped. Playwright/Chromium leaves `navigator.onLine`
+ *    stale-`true` after a navigation even though the network is still down,
+ *    and src/data/http.ts classifies a failed fetch by that flag, so the test
+ *    syncs the flag with the proven-down state in the reloaded document only;
+ *    the network cut itself is `setOffline`, which is what makes the uncached
+ *    shard's fetch fail.
+ * 4. Pick the town again: the cached shards render their verdicts from the
+ *    worker, and the uncached shard's plants say 'needs connection'
+ *    (src/i18n/en.json: `offline.plant.needsConnection`) rather than guess.
+ *    With the context offline, every request that reaches the network layer
+ *    fails -- so the cached content rendering at all is the proof it came
+ *    from the worker, and the only failed request the whole page may have is
+ *    the one shard we deliberately removed.
+ */
+
+test.use({ baseURL: 'http://localhost:4173' });
+
+/** Loads the app, waits for the worker to take control, and returns the bundle's dataVersion. */
+async function controlled(page: Page): Promise<string> {
+  await page.goto('/');
+  await page.evaluate(async () => {
+    await navigator.serviceWorker.ready;
+  });
+  // clients.claim() takes the open page; wait until it has.
+  await expect
+    .poll(() => page.evaluate(() => navigator.serviceWorker.controller !== null))
+    .toBe(true);
+  return page.evaluate(async () => {
+    const response = await fetch('/data/manifest.json');
+    return ((await response.json()) as { dataVersion: string }).dataVersion;
+  });
+}
+
+test('a saved garden renders from cache with the network cut, and an uncached shard says needs connection', async ({
+  page,
+  context,
+}) => {
+  const dataVersion = await controlled(page);
+  const dataCache = `data-${dataVersion}`;
+
+  // Phase 1: online -- pick a town so the results load every shard they use.
+  await page.getByLabel('Town').selectOption({ label: 'Gothenburg' });
+  await expect(page.locator('#result-card-sorbus-aucuparia')).toBeVisible();
+
+  // The town list, region pack and sources registry are fetched on demand,
+  // not part of the shell precache -- make sure this session has them, so the
+  // offline reload can still show the town picker and the results section's
+  // citations.
+  await page.evaluate(async (dataVersion) => {
+    for (const path of [
+      '/data/regions/se/locations.json',
+      '/data/regions/se/region.json',
+      '/data/sources.json',
+    ]) {
+      const response = await fetch(`${path}?v=${dataVersion}`);
+      if (!response.ok) throw new Error(`could not precache ${path}: ${response.status}`);
+    }
+  }, dataVersion);
+
+  // Phase 2: one shard is now uncached. Deleted while online so nothing can
+  // re-cache it; prefer a shard that does not hold sorbus-aucuparia, so the
+  // cached-content assertion below keeps pointing at a card we know renders.
+  const removed = await page.evaluate(
+    async ([cacheName, dataVersion]) => {
+      const cache = await caches.open(cacheName);
+      const keys = (await cache.keys()).map((request) => request.url);
+      const shardKeys = keys.filter(
+        (key) => key.includes('/data/catalogue/plants/') && key.endsWith(`?v=${dataVersion}`),
+      );
+      if (shardKeys.length === 0) return undefined;
+
+      // The index is cached, so this reads from the worker -- no network.
+      const index = (await (await fetch(`/data/catalogue/index.json?v=${dataVersion}`)).json()) as {
+        plants: readonly { id: string; scientificName: string; shard: string }[];
+      };
+      const namesIn = (key: string) => {
+        const shard = new URL(key).pathname.split('/').pop() as string;
+        return index.plants.filter((entry) => entry.shard === shard);
+      };
+      const key =
+        shardKeys.find((candidate) => !namesIn(candidate).some((entry) => entry.id === 'sorbus-aucuparia')) ??
+        (shardKeys[0] as string | undefined);
+      if (key === undefined) return undefined;
+      await cache.delete(key);
+      return { key, names: namesIn(key).map((entry) => entry.scientificName) };
+    },
+    [dataCache, dataVersion] as const,
+  );
+  expect(removed?.names.length ?? 0).toBeGreaterThan(0);
+
+  // The deletion must have stuck -- checked against the cache only. A `fetch`
+  // would go through the worker and re-store the file (storeVerified), so it
+  // is deliberately not used here.
+  const deletedKeyStillCached = await page.evaluate(
+    async ([cacheName, key]) => {
+      const cache = await caches.open(cacheName);
+      return (await cache.keys()).some((request) => request.url === key);
+    },
+    [dataCache, removed?.key ?? ''] as const,
+  );
+  expect(deletedKeyStillCached).toBe(false);
+
+  // Phase 3: the network is cut for real -- a fetch of a file that is not in
+  // any cache must fail. This is the actual offline condition, independent of
+  // navigator.onLine.
+  await context.setOffline(true);
+  const networkIsDown = await page.evaluate(async () => {
+    try {
+      await fetch('/data/regions/se/locations.json?v=0000000000000000');
+      return false;
+    } catch {
+      return true;
+    }
+  });
+  expect(networkIsDown).toBe(true);
+
+  // Reload to reset the app's loaded state. Navigations are not intercepted by
+  // the worker, so the page still loads from the shell cache, but every data
+  // fetch after it reaches the network layer and fails.
+  await page.reload();
+  await expect
+    .poll(() => page.evaluate(() => navigator.serviceWorker.controller !== null))
+    .toBe(true);
+
+  // Playwright/Chromium leaves navigator.onLine stale-`true` after a navigation
+  // even though the network is genuinely down (verified: the fetch above still
+  // throws), and src/data/http.ts reads that flag to decide between 'needs
+  // connection' and a generic failure. Sync it with the real state -- proven
+  // by `networkIsDown` above, not assumed -- in this document only, right
+  // before the app's first offline fetch. The offline condition itself is
+  // `context.setOffline(true)`, which is what makes the uncached shard's fetch
+  // fail; this only keeps the app's classifier honest about a flag the browser
+  // misreports.
+  await page.evaluate(() => {
+    Object.defineProperty(navigator, 'onLine', { configurable: true, get: () => false });
+  });
+
+  // With the context offline, a request only succeeds if the worker answers
+  // it from its caches. So the cached content must come from the worker, and
+  // the one failure the whole page may have is the shard we just removed.
+  const failedRequests: string[] = [];
+  const dataFromWorker: string[] = [];
+  page.on('requestfailed', (request) => failedRequests.push(request.url()));
+  page.on('response', (response) => {
+    if (response.fromServiceWorker() && new URL(response.url()).pathname.startsWith('/data/')) {
+      dataFromWorker.push(new URL(response.url()).pathname);
+    }
+  });
+
+  // Phase 4: the saved garden must have come back from localStorage -- the
+  // whole point of P3-07, and the thing this test is about working offline.
+  await expect(
+    page.getByRole('region', { name: 'Your gardens' }).getByRole('button', { name: 'Gothenburg' }),
+  ).toBeVisible();
+
+  // Re-select the saved garden -- the first data fetch since the cut, so it
+  // happens offline. The cached shards load; the deleted one cannot.
+  await page.getByLabel('Town').selectOption({ label: 'Gothenburg' });
+
+  // The cached shards kept their verdicts -- the saved garden renders fully.
+  await expect(page.locator('#result-card-sorbus-aucuparia')).toBeVisible();
+
+  // The uncached shard's plants say needs connection, by name.
+  for (const name of removed?.names ?? []) {
+    const placeholder = page.getByRole('listitem').filter({ hasText: name });
+    await expect(placeholder).toContainText('This plant needs a connection to load its data.');
+  }
+
+  // The cached content came from the worker, not the network: the catalogue
+  // index and at least one shard were all answered by the service worker.
+  expect(dataFromWorker.some((path) => path === '/data/catalogue/index.json')).toBe(true);
+  expect(dataFromWorker.filter((path) => path.startsWith('/data/catalogue/plants/'))).not.toEqual([]);
+
+  // And nothing that was cached ever needed the wire: the only data-file
+  // failures are the shard we removed and photographs, which P3-17's policy
+  // deliberately does not cache ("photographs not cached -- P3-18's call").
+  for (const url of failedRequests) {
+    const pathname = new URL(url).pathname;
+    if (pathname.startsWith('/data/')) {
+      expect(pathname).toBe(new URL(removed?.key ?? '').pathname);
+    } else {
+      expect(pathname).toMatch(/^\/images\//);
+    }
+  }
+});
