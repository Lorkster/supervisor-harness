diff --git a/tests/component/ResultsSection.test.tsx b/tests/component/ResultsSection.test.tsx
new file mode 100644
index 0000000..27a03d5
--- /dev/null
+++ b/tests/component/ResultsSection.test.tsx
@@ -0,0 +1,162 @@
+/**
+ * P3-18 -- a shard that does not load must say 'needs connection' for its
+ * plants only, while the cached shards keep their verdicts.
+ *
+ * The old shape (Promise.all over every shard) turned one failed fetch into
+ * a section-level error and hid every plant that had loaded fine. These pin
+ * the per-shard behaviour: partial success renders the successful plants and
+ * placeholders for the failed shard's, and the wording branches on the data
+ * layer's 'offline-unavailable' code rather than on a guess.
+ */
+
+import { render, screen } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { ResultsSection } from '../../src/app/results/ResultsSection.tsx';
+import { LocaleContext } from '../../src/app/locale.ts';
+import type { Manifest } from '../../src/data/index.ts';
+import { basePlant, baseSite } from '../domain/matching/fixtures.ts';
+import type { Plant } from '../../src/domain/types.ts';
+
+// Mutable per-test state the mocked data layer reads. `vi.mock` is hoisted
+// above every import, so the factory may only touch `vi.hoisted()` bindings:
+// each test sets its own index and shard behaviour here, and the component
+// reads exactly that at call time.
+/** A plain descriptor for a data-layer failure; the mock turns it into a real `DataError` from its own module instance, so the component's `instanceof` check sees the same class. */
+interface ShapedError {
+  code: 'offline-unavailable' | 'fetch-failed';
+  message: string;
+}
+
+const mockState = vi.hoisted(() => ({
+  indexResult: { plants: [] as unknown[] },
+  indexError: undefined as ShapedError | undefined,
+  shardBehavior: (shard: string): unknown => {
+    void shard;
+    return [];
+  },
+}));
+
+vi.mock('../../src/data/index.ts', async () => {
+  const { DataError } = await import('../../src/data/errors.ts');
+  return {
+    loadAppConfig: vi.fn(async () => ({})),
+    loadSources: vi.fn(async () => ({})),
+    loadCatalogueIndex: vi.fn(async () => {
+      if (mockState.indexError !== undefined) {
+        throw new DataError(mockState.indexError.code, mockState.indexError.message);
+      }
+      return mockState.indexResult;
+    }),
+    loadCatalogueShard: vi.fn(async (_manifest: Manifest, shard: string) => {
+      const result = mockState.shardBehavior(shard);
+      if (result !== null && typeof result === 'object' && 'code' in result) {
+        const shaped = result as ShapedError;
+        throw new DataError(shaped.code, shaped.message);
+      }
+      return result;
+    }),
+  };
+});
+
+import { loadCatalogueIndex, loadCatalogueShard } from '../../src/data/index.ts';
+
+const manifest = {
+  schemaVersion: 1,
+  dataVersion: 'test',
+  generatedAt: '2024-01-01T00:00:00Z',
+  files: {},
+} as unknown as Manifest;
+
+function indexEntry(id: string, scientificName: string, shard: string) {
+  return {
+    id,
+    scientificName,
+    genus: 'Testus',
+    family: 'Testaceae',
+    form: 'shrub',
+    uses: [],
+    status: 'published',
+    shard,
+  };
+}
+
+function plant(id: string): Plant {
+  return { ...basePlant, id: id as Plant['id'], scientificName: `Testus ${id}` };
+}
+
+function renderSection() {
+  return render(
+    <LocaleContext value={{ locale: 'en', setLocale: () => undefined }}>
+      <ResultsSection manifest={manifest} siteProfile={baseSite} />
+    </LocaleContext>,
+  );
+}
+
+beforeEach(() => {
+  mockState.indexResult = { plants: [] };
+  mockState.indexError = undefined;
+  mockState.shardBehavior = () => [];
+  vi.mocked(loadCatalogueIndex).mockClear();
+  vi.mocked(loadCatalogueShard).mockClear();
+});
+
+describe('ResultsSection shard failures (P3-18)', () => {
+  it('renders every plant when all shards load', async () => {
+    mockState.indexResult = { plants: [indexEntry('a', 'Testus a', 's1')] };
+    mockState.shardBehavior = () => [plant('a')];
+
+    renderSection();
+
+    expect(await screen.findByText('Testus a')).toBeDefined();
+    expect(screen.queryByText(/needs a connection/i)).toBeNull();
+  });
+
+  it("renders the loaded shard's plants and a 'needs connection' placeholder for the failed shard's", async () => {
+    mockState.indexResult = {
+      plants: [indexEntry('a', 'Testus a', 's1'), indexEntry('b', 'Testus b', 's2')],
+    };
+    mockState.shardBehavior = (shard) =>
+      shard === 's2'
+        ? {
+            code: 'offline-unavailable' as const,
+            message: 'Could not reach /data/catalogue/plants/s2 while offline.',
+          }
+        : [plant('a')];
+
+    renderSection();
+
+    // The cached plant keeps its card; the uncached one gets a placeholder.
+    expect(await screen.findByText('Testus a')).toBeDefined();
+    const placeholder = await screen.findByText('Testus b');
+    expect(placeholder.parentElement?.textContent).toContain('needs a connection');
+    // ...and not the generic error wording, which is for other failure kinds.
+    expect(screen.queryByText(/Couldn't load the plant catalogue/i)).toBeNull();
+  });
+
+  it('falls back to the generic load-error message when the shard failed for another reason', async () => {
+    mockState.indexResult = {
+      plants: [indexEntry('a', 'Testus a', 's1'), indexEntry('b', 'Testus b', 's2')],
+    };
+    mockState.shardBehavior = (shard) =>
+      shard === 's2'
+        ? { code: 'fetch-failed' as const, message: 'Could not reach /data/catalogue/plants/s2.' }
+        : [plant('a')];
+
+    renderSection();
+
+    expect(await screen.findByText('Testus a')).toBeDefined();
+    const placeholder = await screen.findByText('Testus b');
+    expect(placeholder.parentElement?.textContent).not.toContain('needs a connection');
+  });
+
+  it('still shows the section-level error when the index itself fails', async () => {
+    mockState.indexError = {
+      code: 'fetch-failed',
+      message: 'Could not reach /data/catalogue/index.json.',
+    };
+
+    renderSection();
+
+    expect(await screen.findByText(/Couldn't load the plant catalogue/i)).toBeDefined();
+  });
+});
diff --git a/tests/data/offlineUnavailable.test.ts b/tests/data/offlineUnavailable.test.ts
new file mode 100644
index 0000000..e9d123c
--- /dev/null
+++ b/tests/data/offlineUnavailable.test.ts
@@ -0,0 +1,92 @@
+/**
+ * An uncached data file fetched with no connection must be classified as
+ * 'offline-unavailable', not 'fetch-failed' (P3-18): the UI needs to say
+ * "needs connection" for a plant or tile it never cached, and that branch is
+ * on `DataError.code` -- never on parsing prose or re-checking
+ * navigator.onLine in components.
+ */
+
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { DataError } from '../../src/data/errors.ts';
+import { fetchJson } from '../../src/data/http.ts';
+
+const url = '/data/regions/se/plants.json';
+
+function setOnline(onLine: boolean): void {
+  vi.stubGlobal('navigator', { onLine });
+}
+
+/** Runs `fetchJson` and returns the `DataError` it threw. */
+async function thrownError(): Promise<DataError> {
+  try {
+    await fetchJson(url);
+  } catch (error) {
+    expect(error).toBeInstanceOf(DataError);
+    return error as DataError;
+  }
+  throw new Error(`expected fetchJson(${url}) to reject`);
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('fetchJson with the network down', () => {
+  it("classifies a thrown fetch as 'offline-unavailable' when navigator.onLine is false", async () => {
+    setOnline(false);
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => {
+        throw new TypeError('Failed to fetch');
+      }),
+    );
+
+    const error = await thrownError();
+    expect(error.code).toBe('offline-unavailable');
+    expect(error.url).toBe(url);
+    expect(error.cause).toBeInstanceOf(TypeError);
+  });
+
+  it("still classifies a thrown fetch as 'fetch-failed' when navigator.onLine is true", async () => {
+    setOnline(true);
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => {
+        throw new TypeError('Failed to fetch');
+      }),
+    );
+
+    const error = await thrownError();
+    expect(error.code).toBe('fetch-failed');
+  });
+
+  it("keeps 'fetch-failed' for a non-2xx response even while offline: the network answered", async () => {
+    setOnline(false);
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () =>
+        ({
+          ok: false,
+          status: 503,
+          statusText: 'Service Unavailable',
+          json: () => Promise.resolve(null),
+        }) as Response,
+      ),
+    );
+
+    const error = await thrownError();
+    expect(error.code).toBe('fetch-failed');
+    expect(error.status).toBe(503);
+  });
+
+  it("stays 'fetch-failed' when navigator is absent (no browser global at all)", async () => {
+    vi.stubGlobal('navigator', undefined);
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => {
+        throw new TypeError('Failed to fetch');
+      }),
+    );
+
+    const error = await thrownError();
+    expect(error.code).toBe('fetch-failed');
+  });
+});
